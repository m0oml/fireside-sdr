# Transmit-isolation check (run with cmake -P). The transmit DSP and firesidetx must never be able to reach the radio: they produce sample
# buffers and WAV files only. Two independent layers, both ALLOWLISTS (anything new fails until someone decides it is safe and adds it here):
#
#   MODE=source  Follows every #include "fireside/X.h" from ROOTS, transitively through INCLUDE_DIR. Every fireside_core header reached must
#                be in ALLOWED_HEADERS; every system include must be a plain standard header (no '/', not a POSIX device/terminal header);
#                the root files must not mention device-level calls (FORBIDDEN_WORDS).
#   MODE=binary  The linked BINARY may only contain strong symbols that come from ALLOWED_OBJECTS of ARCHIVE (libfireside_core.a), and must not
#                import ALSA (snd_*) or ioctl. This catches a radio module pulled in through a .cpp, which the header scan cannot see.
#
# GUI=ON (with LOCAL_DIR) checks the transmit tab: besides the above, quoted includes are allowed only for ALLOWED_LOCAL (found in LOCAL_DIR and
# scanned too), and the roots must not mention a transmit key, a radio session, the other panels, or any sound/network/process class.
#
# Failures print "TX ISOLATION VIOLATION: ..." (the self-tests look for that text, so they cannot pass on an unrelated script error).

set(ALLOWED_HEADERS dsp.h decode.h tx_dsp.h tx_render.h)
set(ALLOWED_OBJECTS dsp.cpp.o decode_cw.cpp.o decode_psk.cpp.o decode_rtty.cpp.o decode_ft8.cpp.o dxcc.cpp.o ft8_osd.cpp.o ft8_demod.cpp.o tx_dsp.cpp.o tx_render.cpp.o)
set(FORBIDDEN_SYSTEM fcntl.h termios.h unistd.h poll.h)
set(FORBIDDEN_WORDS "snd_[a-z]" "ioctl" "\"/dev/" "open_alsa" "rawmidi" "PcmIqSource")
set(ALLOWED_LOCAL TxPanel.h Theme.h)
set(FORBIDDEN_WORDS_GUI "[Pp][Tt][Tt]" "[Mm][Oo][Xx]" "[Ss]ession" "Tuner" "RadioPanel" "ReceiverPanel" "MainWindow" "AudioOut" "QAudio" "QMedia" "QSerialPort" "QTcp" "QUdp" "QLocalSocket" "QProcess" "QNetwork")

function(violation msg)
  message(NOTICE "TX ISOLATION VIOLATION: ${msg}")      # one unwrapped line (FATAL_ERROR text is word-wrapped)
  message(FATAL_ERROR "transmit isolation check failed")
endfunction()

if(MODE STREQUAL "source")
  if(GUI AND NOT LOCAL_DIR)
    message(FATAL_ERROR "GUI=ON needs LOCAL_DIR")
  endif()
  if(NOT ROOTS OR NOT INCLUDE_DIR)
    message(FATAL_ERROR "usage: cmake -DMODE=source -DROOTS=a;b -DINCLUDE_DIR=dir -P tx_isolation.cmake")
  endif()
  foreach(r IN LISTS ROOTS)
    if(NOT EXISTS "${r}")
      message(FATAL_ERROR "root file missing: ${r}")
    endif()
    file(READ "${r}" text)
    set(words ${FORBIDDEN_WORDS})
    if(GUI)
      list(APPEND words ${FORBIDDEN_WORDS_GUI})
    endif()
    foreach(w IN LISTS words)
      if(text MATCHES "${w}")
        violation("${r} mentions '${CMAKE_MATCH_0}' (device-level access is not allowed in transmit code)")
      endif()
    endforeach()
  endforeach()
  set(queue ${ROOTS})
  set(seen "")
  set(checked 0)
  while(queue)
    list(POP_FRONT queue f)
    if(f IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${f}")
    math(EXPR checked "${checked} + 1")
    file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include")
    foreach(line IN LISTS lines)
      if(NOT line MATCHES "#[ \t]*include[ \t]*([<\"])([^>\"]+)[>\"]")
        violation("${f}: cannot parse include line '${line}'")
      endif()
      set(kind "${CMAKE_MATCH_1}")
      set(name "${CMAKE_MATCH_2}")
      if(name MATCHES "^fireside/(.+)$")
        set(h "${CMAKE_MATCH_1}")
        if(NOT h IN_LIST ALLOWED_HEADERS)
          violation("${f} includes fireside/${h}, which is not on the transmit allowlist (${ALLOWED_HEADERS})")
        endif()
        if(NOT EXISTS "${INCLUDE_DIR}/fireside/${h}")
          message(FATAL_ERROR "${f}: include not found: ${INCLUDE_DIR}/fireside/${h}")
        endif()
        list(APPEND queue "${INCLUDE_DIR}/fireside/${h}")
      elseif(kind STREQUAL "\"" AND GUI AND name IN_LIST ALLOWED_LOCAL)
        if(NOT EXISTS "${LOCAL_DIR}/${name}")
          message(FATAL_ERROR "${f}: include not found: ${LOCAL_DIR}/${name}")
        endif()
        list(APPEND queue "${LOCAL_DIR}/${name}")
      elseif(kind STREQUAL "\"")
        violation("${f} includes \"${name}\": transmit code may only use fireside/ allowlisted headers and standard headers")
      elseif(name MATCHES "/" OR name IN_LIST FORBIDDEN_SYSTEM)
        violation("${f} includes <${name}>: only plain standard headers are allowed (no device, POSIX I/O or library headers)")
      endif()
    endforeach()
  endwhile()
  message(STATUS "tx isolation (source): ${checked} files checked, all includes allowed")

elseif(MODE STREQUAL "binary")
  if(NOT BINARY OR NOT ARCHIVE OR NOT NM)
    message(FATAL_ERROR "usage: cmake -DMODE=binary -DBINARY=exe -DARCHIVE=libfireside_core.a -DNM=nm -P tx_isolation.cmake")
  endif()
  foreach(p "${BINARY}" "${ARCHIVE}")
    if(NOT EXISTS "${p}")
      message(FATAL_ERROR "missing: ${p}")
    endif()
  endforeach()
  execute_process(COMMAND "${NM}" --defined-only -g "${ARCHIVE}" OUTPUT_VARIABLE arch RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm failed on ${ARCHIVE}")
  endif()
  string(REPLACE "\n" ";" arch_lines "${arch}")
  set(obj "")
  set(nstrong 0)
  foreach(l IN LISTS arch_lines)
    if(l MATCHES "^(.+\\.o):$")
      set(obj "${CMAKE_MATCH_1}")
    elseif(l MATCHES "^[0-9a-fA-F]+ ([TDBR]) (.+)$")
      set("owner_${CMAKE_MATCH_2}" "${obj}")                   # strong symbols belong to exactly one object
      math(EXPR nstrong "${nstrong} + 1")
    endif()
  endforeach()
  if(nstrong LESS 50)
    message(FATAL_ERROR "only ${nstrong} strong symbols found in ${ARCHIVE}: nm output not understood")
  endif()
  execute_process(COMMAND "${NM}" --defined-only "${BINARY}" OUTPUT_VARIABLE bin RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm failed on ${BINARY}")
  endif()
  string(REPLACE "\n" ";" bin_lines "${bin}")
  set(used "")
  foreach(l IN LISTS bin_lines)
    if(l MATCHES "^[0-9a-fA-F]+ [A-Za-z] (.+)$")
      set(s "${CMAKE_MATCH_1}")
      if(DEFINED "owner_${s}")
        set(o "${owner_${s}}")
        if(NOT o IN_LIST ALLOWED_OBJECTS)
          violation("${BINARY} contains ${s} from ${o}, which is not on the transmit allowlist")
        endif()
        if(NOT o IN_LIST used)
          list(APPEND used "${o}")
        endif()
      endif()
    endif()
  endforeach()
  execute_process(COMMAND "${NM}" -u "${BINARY}" OUTPUT_VARIABLE und ERROR_QUIET)
  if(und MATCHES "(snd_[A-Za-z_]+|ioctl)")
    violation("${BINARY} imports ${CMAKE_MATCH_1} (sound card / device access)")
  endif()
  list(SORT used)
  message(STATUS "tx isolation (binary): ${BINARY} uses only ${used}")
else()
  message(FATAL_ERROR "MODE must be source or binary")
endif()
